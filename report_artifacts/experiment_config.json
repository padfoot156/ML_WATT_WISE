{
  "experiment_name": "WattWise_AI_National_24h_Forecasting_Benchmark",
  "random_seed": 42,
  "chronological_splits": {
    "train": {
      "start": "2024-01-15 00:00:00",
      "end": "2024-11-30 23:00:00",
      "samples": 7704
    },
    "validation": {
      "start": "2024-12-01 00:00:00",
      "end": "2025-02-28 23:00:00",
      "samples": 2160
    },
    "test": {
      "start": "2025-03-01 00:00:00",
      "end": "2025-06-24 23:00:00",
      "samples": 2784
    }
  },
  "target": "demand_mw",
  "horizon": "24-Hour Day-Ahead Direct / Walk-Forward",
  "feature_count": 30,
  "scaling": "StandardScaler fitted strictly on training data",
  "models": {
    "seasonal_naive": {
      "baseline_lag": 24
    },
    "ridge": {
      "alpha": 100.0,
      "solver": "auto"
    },
    "decision_tree": {
      "max_depth": 12,
      "min_samples_split": 20,
      "min_samples_leaf": 10
    },
    "random_forest": {
      "n_estimators": 100,
      "max_depth": 16,
      "min_samples_leaf": 5,
      "n_jobs": -1
    },
    "gradient_boosting": {
      "n_estimators": 120,
      "learning_rate": 0.08,
      "max_depth": 6
    },
    "lstm": {
      "framework": "PyTorch 2.14.1+cpu",
      "sequence_length": 24,
      "hidden_dim": 64,
      "num_layers": 2,
      "dropout": 0.2,
      "learning_rate": 0.002,
      "weight_decay": 1e-05,
      "batch_size": 64,
      "max_epochs": 20,
      "early_stopping_patience": 5,
      "loss_function": "MSELoss",
      "optimizer": "Adam"
    }
  },
  "clustering": {
    "algorithms": [
      "K-Means",
      "Agglomerative Hierarchical (Ward Linkage)"
    ],
    "k_values": [
      2,
      3,
      4,
      5,
      6
    ],
    "optimal_k": 3,
    "feature_representation": "24-hour standardized diurnal demand shape vector"
  }
}